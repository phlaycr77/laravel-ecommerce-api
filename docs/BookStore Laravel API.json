          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\r\nconst token = res.access_token || (res.data && res.data.access_token) || res.token;\r\nif (token) {\r\n    pm.collectionVariables.set(\"customer_token\", token);\r\n    console.log(\"Đã lưu customer_token thành công!\");\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"khachdemo@gmail.com\",\r\n    \"password\": \"password\"\r\n}",
